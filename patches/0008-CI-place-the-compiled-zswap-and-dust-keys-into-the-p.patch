From 03d51e59647d748cd29dbcf4fde7090fbe04cebf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 22:14:03 +0000
Subject: [PATCH 08/10] CI: place the compiled zswap and dust keys into the
 parameter cache

The zswap unit test `prove::tests::test_proof_sizes` reads the published
zswap keys from `$MIDNIGHT_PP/zswap/<version>/` in `FetchMode::Synchronous`
mode, which never downloads. flake.nix's `local-params` package fills that
cache from `zkir-precompiles/*`; both workflow jobs now do the same after
compiling the test artifacts, and check the nine zswap files against the
SHA-256 sidecars that midnight-zswap compiles in (`zswap/static/*.sha256`),
so a compiled key that differed from the published one fails the job
instead of being served. The first run on 6ff98056 failed at exactly this
point; every step before it (run metadata, mock-verify assertion,
parameter download, CLI and artifact builds, the zkir and coin-structure
suites) had passed.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Q9CJgdhDhwqKR5eCeFM2VG
---
 .github/workflows/csl-proving.yml | 36 +++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/.github/workflows/csl-proving.yml b/.github/workflows/csl-proving.yml
index a6619748..88adea26 100644
--- a/.github/workflows/csl-proving.yml
+++ b/.github/workflows/csl-proving.yml
@@ -106,6 +106,24 @@ jobs:
             "$bin" compile-many "$art/$name/zkir" "$art/$name/keys"
           done
 
+      - name: Local parameters (compiled zswap and dust keys into the cache, as flake.nix local-params does)
+        run: |
+          set -euo pipefail
+          ver=$(tr -d '\n' < static/version)
+          art="$MIDNIGHT_LEDGER_TEST_STATIC_DIR"
+          for c in zswap dust; do
+            mkdir -p "$MIDNIGHT_PP/$c/$ver"
+            cp -a "$art/$c/zkir/." "$MIDNIGHT_PP/$c/$ver/"
+            cp -a "$art/$c/keys/." "$MIDNIGHT_PP/$c/$ver/"
+          done
+          # The data provider serves a cached file only if its SHA-256 matches the sidecar compiled
+          # into midnight-zswap (zswap/static/*.sha256). Check here so a mismatch fails early and loudly.
+          for f in spend.prover spend.verifier spend.bzkir output.prover output.verifier output.bzkir sign.prover sign.verifier sign.bzkir; do
+            exp=$(cut -c1-64 "zswap/static/$f.sha256"); got=$(sha256sum "$MIDNIGHT_PP/zswap/$ver/$f" | cut -c1-64)
+            [ "$exp" = "$got" ] || { echo "zswap/$ver/$f: compiled key differs from the pinned hash ($got != $exp)"; exit 1; }
+            echo "zswap/$ver/$f matches the pinned hash"
+          done
+
       - name: Unit suites touched by the change
         run: |
           cargo test --release -p midnight-coin-structure custom_spend
@@ -179,6 +197,24 @@ jobs:
             if [ "$ver" = "2" ]; then bin=.csl/bin/zkir-v2; else bin=.csl/bin/zkir-v3; fi
             "$bin" compile-many "$art/$name/zkir" "$art/$name/keys"
           done
+      - name: Local parameters (compiled zswap and dust keys into the cache, as flake.nix local-params does)
+        run: |
+          set -euo pipefail
+          ver=$(tr -d '\n' < static/version)
+          art="$MIDNIGHT_LEDGER_TEST_STATIC_DIR"
+          for c in zswap dust; do
+            mkdir -p "$MIDNIGHT_PP/$c/$ver"
+            cp -a "$art/$c/zkir/." "$MIDNIGHT_PP/$c/$ver/"
+            cp -a "$art/$c/keys/." "$MIDNIGHT_PP/$c/$ver/"
+          done
+          # The data provider serves a cached file only if its SHA-256 matches the sidecar compiled
+          # into midnight-zswap (zswap/static/*.sha256). Check here so a mismatch fails early and loudly.
+          for f in spend.prover spend.verifier spend.bzkir output.prover output.verifier output.bzkir sign.prover sign.verifier sign.bzkir; do
+            exp=$(cut -c1-64 "zswap/static/$f.sha256"); got=$(sha256sum "$MIDNIGHT_PP/zswap/$ver/$f" | cut -c1-64)
+            [ "$exp" = "$got" ] || { echo "zswap/$ver/$f: compiled key differs from the pinned hash ($got != $exp)"; exit 1; }
+            echo "zswap/$ver/$f matches the pinned hash"
+          done
+
       - name: Assert mock-verify absent
         run: |
           n=$(cargo tree -p midnight-ledger-v10 --features proving -e features | grep -c 'mock-verify' || true); echo "mock-verify occurrences: $n"; [ "$n" = "0" ]

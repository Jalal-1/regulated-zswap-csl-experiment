+        PERMISSIVE_KEY_LOCATION,
+        program,
+        witness.private_transcript(),
+        None,
+    );
+    Transaction::new(
+        "local-test",
+        test_intents(rng, vec![call], Vec::new(), Vec::new(), state.time),
+        Some(offer),
+        Default::default(),
+    )
